# Optional overrides for the root compose.yaml. Defaults work without this file.
WEB_HTTPS_PORT=8443
DEMO_MODE=true
VITE_HOST_MODE=demo
NLP_MODE=mock
# For MAX: DEMO_MODE=false, VITE_HOST_MODE=max, CORE_SERVICE_TOKEN=<private token>.
# For live Groq: NLP_MODE=live, GROQ_API_KEY=<private key>, GROQ_MODEL=<model>.
# Keep real credentials only in an ignored .env or in the server environment.
