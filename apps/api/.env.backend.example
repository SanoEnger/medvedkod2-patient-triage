# Never commit real tokens, keys or medical data.
CORE_URL=https://tm-test-yakut.hostco.ru
CORE_SERVICE_TOKEN=
SESSION_SIGNING_KEY=
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173
FRAME_ANCESTORS='self'
AUTH_TTL_SECONDS=3600
SURVEY_TTL_SECONDS=86400
CORE_TIMEOUT_SECONDS=6

# PostgreSQL is required. TLS verifies both the certificate authority and host.
# Do not put ssl/sslmode query parameters in DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://medved:change-me@localhost:5432/medved
# Empty means the operating system's trusted certificate authorities.
DATABASE_SSL_CA_FILE=
# File containing a base64-encoded random 32-byte AES key; keep outside Git.
DATA_ENCRYPTION_KEY_FILE=

# HTTPS listener; an unencrypted HTTP listener is never started.
API_HOST=127.0.0.1
API_PORT=8443
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
