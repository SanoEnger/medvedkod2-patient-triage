GROQ_API_KEY=
WHISPER_MODEL_PATH=
# Vercel: VOICE_PROVIDER=groq uses the server-side GROQ_API_KEY; Docker defaults to local.
VOICE_PROVIDER=local
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Select a currently available model supporting JSON mode in your Groq account.
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=7
NLP_MODE=mock

# Server configuration for apps/api/.env. Never commit actual credentials.
CORE_URL=https://tm-test-yakut.hostco.ru
CORE_SERVICE_TOKEN=
CORE_RELAY_URL=
CORE_RELAY_TOKEN=
CORE_TIMEOUT_SECONDS=6
SESSION_SIGNING_KEY=
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173
FRAME_ANCESTORS='self'
AUTH_TTL_SECONDS=3600
SURVEY_TTL_SECONDS=86400

# Standalone PostgreSQL: verified TLS; no ssl/sslmode query parameters here.
DATABASE_URL=postgresql+asyncpg://medved:change-me@localhost:5432/medved
DATABASE_SSL_CA_FILE=
DATA_ENCRYPTION_KEY_FILE=
# Vercel can use a base64-encoded 32-byte key instead of a key file.
DATA_ENCRYPTION_KEY=

# Standalone API HTTPS listener. Managed hosting terminates HTTPS separately.
API_HOST=127.0.0.1
API_PORT=8443
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
